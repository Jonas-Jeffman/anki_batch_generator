            "pos": "verb",
            "senses": [
              {
                "native_id": "nail__15",
                "definition": "to catch someone and prove that they are guilty of a crime or of doing something bad",
                "examples": [
                  {
                    "text": "The government spent vast resources in an unsuccessful effort to nail him on felony charges.",
                    "audio_url": ""
