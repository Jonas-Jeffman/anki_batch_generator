      "longman": {
        "entries": [
          {
            "entry_type": "ldoce",
            "headword": "nail",
            "pos": "noun",
            "senses": [
              {
                "native_id": "nail__1",
                "definition": "a thin pointed piece of metal with a flat top, which you hit into a surface with a hammer , for example to join things together or to hang something on",
                "examples": [
                  {
                    "text": "The key was hanging on a nail by the door.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714242.mp3?version=1.2.91"
                  },
                  {
                    "text": "She hammered a nail into the wall.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714245.mp3?version=1.2.91"
                  }
                ]
              },
              {
                "native_id": "nail__2",
                "definition": "your nails are the hard smooth layers on the ends of your fingers and toes",
                "examples": [
                  {
                    "text": "I’ve broken my nail .",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-000231691.mp3?version=1.2.91"
                  },
                  {
                    "text": "Stop biting your nails !",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714250.mp3?version=1.2.91"
                  },
                  {
                    "text": "She sat painting her nails (= putting a coloured substance on them )",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714253.mp3?version=1.2.91"
                  },
                  {
                    "text": "He still had dirt under his nails. → fingernail , toenail",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714257.mp3?version=1.2.91"
                  }
                ]
              }
            ],
            "cross_reference_ids": [
              "nail__3",
              "nail__4",
              "nail__5"
            ],
            "other_sense_ids": []
          },
          {
            "entry_type": "ldoce",
            "headword": "nail",
            "pos": "verb",
            "senses": [
              {
                "native_id": "nail__7",
                "definition": "to fasten something to something else with nails",
                "examples": [
                  {
                    "text": "A sign saying ‘No Fishing’ had been nailed to the tree.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-000231734.mp3?version=1.2.91"
                  },
                  {
                    "text": "The lid was firmly nailed down.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-000231735.mp3?version=1.2.91"
                  },
                  {
                    "text": "The windows had been nailed up.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714288.mp3?version=1.2.91"
                  }
                ]
              },
              {
                "native_id": "nail__8",
                "definition": "to catch someone and prove that they are guilty of a crime or something bad",
                "examples": [
                  {
                    "text": "It took us 10 years to nail the guy who killed our daughter.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-000231741.mp3?version=1.2.91"
                  },
                  {
                    "text": "The state police finally nailed him for fraud.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-000231744.mp3?version=1.2.91"
                  }
                ]
              },
              {
                "native_id": "nail__9",
                "definition": "if you nail something, you succeed in getting it, after a lot of time or effort",
                "examples": [
                  {
                    "text": "She finally nailed her dream job.",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/p008-001714294.mp3?version=1.2.91"
                  }
                ]
              },
              {
                "native_id": "nail__10",
                "definition": "to do something perfectly, especially when singing or performing",
                "examples": [
                  {
                    "text": "I thought that song might be too big for you, but you absolutely nailed it !",
                    "audio_url": "https://www.ldoceonline.com/media/english/exaProns/ldoce6exa_00610.mp3?version=1.2.91"
                  }
                ]
              }
            ],
            "cross_reference_ids": [
              "nail__11",
              "nail__12",
              "nail__13"
            ],
            "other_sense_ids": []
          },
          {
            "entry_type": "business",
