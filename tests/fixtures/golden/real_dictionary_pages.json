        "cald_senses": [
          {
            "native_id": "ID_00021248_01",
            "pos": "noun",
            "definition": "a small , thin piece of metal with one pointed end and one flat end that you hit into something with a hammer , especially in order to fasten or join it to something else",
            "examples": [
              "a three-inch nail",
              "I stepped on a nail sticking out of the floorboards .",
              "Hammer a nail into the wall and we'll hang the mirror from it."
            ],
            "image_path": "/images/full/nail_noun_002_24408.jpg?version=6.0.80",
            "image_dom_relation": "before_next_def_block"
          },
          {
            "native_id": "ID_00021248_02",
            "pos": "noun",
            "definition": "a thin , hard area that covers the upper side of the end of each finger and each toe",
            "examples": [
              "Stop biting your nails!",
              "nail clippers",
              "a nail file"
            ],
            "image_path": "/images/full/finger_noun_002_13904.jpg?version=6.0.80",
            "image_dom_relation": "before_next_def_block"
          },
          {
            "native_id": "ID_00021248_05",
            "pos": "verb",
            "definition": "to fasten something with nails",
            "examples": [
              "She had nailed a small shelf to the door .",
              "A notice had been nailed up on the wall .",
              "The lid of the box had been nailed down."
            ],
            "image_path": "",
            "image_dom_relation": "none"
          },
          {
            "native_id": "ID_00021248_06",
            "pos": "verb",
            "definition": "to catch someone, especially when they are doing something wrong , or to make it clear that they are guilty",
            "examples": [
              "The police had been trying to nail those guys for months ."
            ],
            "image_path": "",
            "image_dom_relation": "none"
          },
          {
            "native_id": "ID_00021248_15",
            "pos": "verb",
            "definition": "to do something successfully",
            "examples": [
              "She nailed her audition and got the lead part in the musical .",
              "You totally nailed it!"
            ],
            "image_path": "",
            "image_dom_relation": "none"
          },
          {
            "native_id": "ID_00021248_16",
            "pos": "verb",
            "definition": "to hit someone or something with force",
            "examples": [
              "I got nailed in the head by someone's elbow .",
              "A piece of wood flew off and nailed him in the eye ."
            ],
            "image_path": "",
            "image_dom_relation": "none"
          }
        ]
